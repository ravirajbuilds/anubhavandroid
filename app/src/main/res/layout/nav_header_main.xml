<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:background="@drawable/hero_health_gradient"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="36dp"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="20dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <FrameLayout
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/logo_halo"
        android:padding="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/anubhav_shell_logo" />

    </FrameLayout>

    <TextView
        android:id="@+id/navHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="true"
        android:maxLines="2"
        android:text="@string/nav_header_title"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/text_white"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navHeaderSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="true"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:text="@string/nav_header_subtitle"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:alpha="0.95" />

    <TextView
        android:id="@+id/navHeaderUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:includeFontPadding="true"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:alpha="0.9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/testsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_accent_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/menu_book_test"
            android:textColor="@color/brand_dark_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reportsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@color/card_background"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="@string/menu_my_reports"
            android:textColor="@color/brand_dark_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
