<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.AktivAdmin" parent="Theme.Material3.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_dark_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/medical_green</item>
        <item name="colorSecondaryVariant">@color/medical_green</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/brand_dark_blue</item>
        <!-- Customize your theme here. -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Accent color -->
        <item name="colorAccent">@color/secondary</item>
    </style>
</resources>
